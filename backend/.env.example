# Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS
CLIENT_URL=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/flowmetrics?retryWrites=true&w=majority

# Authentication Secrets & Credentials
JWT_SECRET=super_secret_flowmetrics_jwt_development_key_change_in_production
ADMIN_EMAIL=admin@flowmetrics.dev
ADMIN_PASSWORD=change_this_admin_password_min_8_chars

# Rate Limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
